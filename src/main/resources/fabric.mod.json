{
	"schemaVersion": 1,
	"id": "irlite",
	"version": "${version}",
	"name": "IRLite",
	"description": "",
	"authors": ["qualet", "ElGatoPro300"],
	"contact": {},
	"license": "CC-BY-ND-4.0",
	"icon": "assets/irlite/icon.png",
	"environment": "*",
	"entrypoints": {
		"fabric-datagen": ["qualet.irlite.client.IrliteDataGenerator"],
		"client": ["qualet.irlite.client.IrliteClient"],
		"main": ["qualet.irlite.Irlite"],
		"bbs-addon": ["qualet.irlite.IrlightsAddon"],
		"bbs-addon-client": ["qualet.irlite.client.IrlightsClientAddon"]
	},
	"mixins": [
		{
			"config": "irlite.client.mixins.json",
			"environment": "client"
		}
	],
	"jars": [
		{
			"file": "META-INF/jars/${irl_core_jar}"
		}
	],
	"depends": {
		"fabricloader": ">=${loader_version}",
		"fabric-api": "*",
		"bbs": "*",
		"minecraft": "~1.21.11",
		"irl-core": "*"
	},
	"suggests": {
		"irlcal_editor": "*"
	}
}
